{
  "name": "linguahub-office-superapp",
  "version": "0.4.23",
  "private": true,
  "description": "LinguaHub Office SuperApp 0.4.23 on Tauri v2 with ERP focus workspaces, quick chat, Windows PDF signing, and resilient GitHub release checks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run page-scripts && vite build",
    "page-scripts": "vite-node scripts/gen-page-scripts.ts",
    "tauri": "tauri",
    "app": "npm run page-scripts && tauri dev",
    "version:check": "node scripts/check-version.mjs",
    "dist": "npm run version:check && npm run page-scripts && tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-node": "6.0.0",
    "vitest": "5.0.5"
  }
}
